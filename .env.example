# Copy to .env.local and fill in real values. Never commit real secrets.

# --- Core ---
MONGODB_URI=mongodb://USER:PASSWORD@localhost:27017/navarichcare?authSource=admin
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# --- LINE portal (optional) ---
LINE_PORTAL_NOTIFY_URL=
LINE_PORTAL_API_TOKEN=

# --- Repair Integration API (/api/integration/v1) ---
# Requests allowed per API key per window, and per client IP per window.
INTEGRATION_API_RATE_LIMIT=120
INTEGRATION_API_IP_RATE_LIMIT=120
INTEGRATION_API_RATE_WINDOW_SECONDS=60
# Accept plain http:// image URLs from the POS (keep false in production).
INTEGRATION_API_ALLOW_HTTP=false
# Optional: base URL used to turn POS-relative image paths ("/api/product-images/...")
# into absolute links when a job is created, e.g. https://pos.example.com
INTEGRATION_POS_ASSET_BASE_URL=
# Set to "off" to silence the structured integration request log.
INTEGRATION_API_LOG=on

# --- Automated tests only (npm test) ---
# Must point at a database whose name ends in _test on localhost. Never production.
MONGODB_URI_TEST=mongodb://USER:PASSWORD@127.0.0.1:27017/navarichcare_test?authSource=admin
